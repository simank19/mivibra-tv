<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="night">#0D0C0B</color>
    <color name="orange">#FF6900</color>

    <style name="Theme.MiVibra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:colorAccent">@color/orange</item>
        <item name="android:colorPrimary">@color/night</item>
        <item name="android:colorPrimaryDark">@color/night</item>
        <item name="android:statusBarColor">@color/night</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.MiVibra.Fullscreen" parent="Theme.MiVibra">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
