<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Muchas listas IPTV usan http:// -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <!-- Raíces de Let's Encrypt: los televisores con Android viejo no las traen y no abren muchos addons ni servidores https -->
            <certificates src="@raw/isrg_roots" />
        </trust-anchors>
    </base-config>
</network-security-config>
