rules_version = '2';
// Reglas de MiVibra TV. Cambia TU_CORREO@gmail.com por el Gmail del superadministrador (en minúsculas).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function admin() { return signedIn() && request.auth.token.email.lower() == 'TU_CORREO@gmail.com'; }
    function cfg() { return get(/databases/$(database)/documents/app/config).data; }
    function allowed() {
      return admin() || (signedIn() && (cfg().open == true || request.auth.token.email.lower() in cfg().allowed));
    }
    // Listas, cuentas Xtream y claves: solo el superadministrador escribe; los usuarios permitidos leen
    match /app/config {
      allow read: if allowed();
      allow write: if admin();
    }
    // Perfiles, favoritos, historial y "continuar viendo" de cada usuario
    match /mivibra/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid && allowed();
    }
    // Panel web: buzón donde llegan las listas para cada TV (la TV las borra apenas llegan).
    // Solo se aceptan listas con los campos y tamaños esperados, y códigos de TV con el formato correcto.
    function str(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    match /inbox/{code}/lists/{id} {
      allow create: if code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['type', 'name', 'url', 'epg', 'host', 'user', 'pass', 'portal', 'mac', 'text', 'at'])
        && request.resource.data.type in ['url', 'xtream', 'stalker', 'text']
        && request.resource.data.at is number
        && request.resource.data.at > request.time.toMillis() - 86400000
        && request.resource.data.at < request.time.toMillis() + 86400000
        && str(request.resource.data, 'name', 100) && str(request.resource.data, 'url', 2000) && str(request.resource.data, 'epg', 2000)
        && str(request.resource.data, 'host', 500) && str(request.resource.data, 'user', 200) && str(request.resource.data, 'pass', 200)
        && str(request.resource.data, 'portal', 500) && str(request.resource.data, 'mac', 40) && str(request.resource.data, 'text', 100000);
      allow get, list, delete: if true;
    }
    // Celular como control por internet (TV Samsung/LG): cada tecla es un documento que la TV lee y borra al instante.
    // La TV solo obedece las teclas que traen su clave (k).
    match /rc/{code}/e/{id} {
      allow create: if code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['t', 'c', 'v', 'k', 'at', 'n'])
        && request.resource.data.t in ['k', 'go', 'text', 'hello']
        && request.resource.data.at is number
        && request.resource.data.at > request.time.toMillis() - 600000
        && request.resource.data.at < request.time.toMillis() + 600000
        && str(request.resource.data, 'c', 20) && str(request.resource.data, 'v', 200) && str(request.resource.data, 'k', 10);
      allow get, list, delete: if true;
    }
    // Conexión directa celular ↔ TV (enviar juegos y mando de juego en Samsung/LG): solo se intercambian los datos para conectarse.
    match /rtc/{code}/s/{id} {
      allow create: if code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['t', 'sid', 'sdp', 'k', 'at'])
        && request.resource.data.t in ['offer', 'answer']
        && request.resource.data.at is number
        && request.resource.data.at > request.time.toMillis() - 600000
        && request.resource.data.at < request.time.toMillis() + 600000
        && str(request.resource.data, 'sid', 40) && str(request.resource.data, 'sdp', 30000) && str(request.resource.data, 'k', 10);
      allow get, list, delete: if true;
    }
  }
}
