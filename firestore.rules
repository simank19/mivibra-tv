rules_version = '2';
// Reglas de MiVibra TV. Cambia TU_CORREO@gmail.com por el Gmail del superadministrador (en minúsculas).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function admin() { return signedIn() && request.auth.token.email.lower() == 'TU_CORREO@gmail.com'; }
    function str(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function cfg() { return get(/databases/$(database)/documents/app/config).data; }
    function allowed() {
      return admin() || (signedIn() && (cfg().open == true || request.auth.token.email.lower() in cfg().allowed));
    }
    // Listas, cuentas Xtream y claves: solo el superadministrador escribe; los usuarios permitidos leen
    match /app/config {
      allow read: if allowed();
      allow write: if admin();
    }
    // Perfiles, favoritos, historial y "continuar viendo" de cada usuario
    match /mivibra/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid && allowed();
    }
    // Comentarios de los usuarios (Ajustes › Enviar comentarios): cada uno escribe los suyos; solo el superadministrador los lee y borra.
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'type', 'text', 'device', 'ver', 'at'])
        && request.resource.data.type in ['idea', 'bug', 'love', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.at is number
        && str(request.resource.data, 'email', 200) && str(request.resource.data, 'name', 100) && str(request.resource.data, 'device', 40) && str(request.resource.data, 'ver', 20);
      // El usuario lee los suyos (para ver la respuesta); el creador lee todos
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if admin();
      // El creador marca leído y responde; el usuario solo marca la respuesta como vista
      allow update: if (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'reply', 'replyAt', 'seen'])
          && (!('reply' in request.resource.data) || (request.resource.data.reply is string && request.resource.data.reply.size() <= 2000)))
        || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']) && request.resource.data.seen == true);
    }
    // MiVibra Movimiento: el avatar 3D (.vrm) de cada usuario, en trozos de menos de 1 MB.
    // Lo escribe solo su dueño; lo pueden leer los usuarios permitidos (para verlo en el público y en partidas en línea).
    match /avatars/{uid} {
      allow read: if allowed();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'parts', 'size', 'at'])
        && request.resource.data.uid == uid && request.resource.data.parts is int && request.resource.data.parts <= 24
        && request.resource.data.size is int && request.resource.data.size <= 22000000 && str(request.resource.data, 'name', 30);
      allow delete: if admin() || (signedIn() && request.auth.uid == uid);
      match /parts/{n} {
        allow read: if allowed();
        allow write: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['n', 'b']) && request.resource.data.b is bytes;
        allow delete: if admin() || (signedIn() && request.auth.uid == uid);
      }
    }
    // Listas propias de cada usuario: él las guarda en su documento; el superadministrador las lee para decidir si las usa.
    match /userLists/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'lists', 'at'])
        && request.resource.data.lists is list && request.resource.data.lists.size() <= 50
        && request.resource.data.at is number
        && str(request.resource.data, 'email', 200) && str(request.resource.data, 'name', 100);
      allow delete: if admin() || (signedIn() && request.auth.uid == uid);
    }
    // Panel web: buzón donde llegan las listas para cada TV (la TV las borra apenas llegan).
    // Solo se aceptan listas con los campos y tamaños esperados, y códigos de TV con el formato correcto.
    match /inbox/{code}/lists/{id} {
      allow create: if code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['type', 'name', 'url', 'epg', 'host', 'user', 'pass', 'portal', 'mac', 'text', 'at'])
        && request.resource.data.type in ['url', 'xtream', 'stalker', 'text']
        && request.resource.data.at is number
        && request.resource.data.at > request.time.toMillis() - 86400000
        && request.resource.data.at < request.time.toMillis() + 86400000
        && str(request.resource.data, 'name', 100) && str(request.resource.data, 'url', 2000) && str(request.resource.data, 'epg', 2000)
        && str(request.resource.data, 'host', 500) && str(request.resource.data, 'user', 200) && str(request.resource.data, 'pass', 200)
        && str(request.resource.data, 'portal', 500) && str(request.resource.data, 'mac', 40) && str(request.resource.data, 'text', 100000);
      allow get, list, delete: if true;
    }
    // Celular como control por internet (TV Samsung/LG): cada tecla es un documento que la TV lee y borra al instante.
    // La TV solo obedece las teclas que traen su clave (k).
    match /rc/{code}/e/{id} {
      allow create: if code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['t', 'c', 'v', 'k', 'at', 'n'])
        && request.resource.data.t in ['k', 'go', 'text', 'hello']
        && request.resource.data.at is number
        && request.resource.data.at > request.time.toMillis() - 600000
        && request.resource.data.at < request.time.toMillis() + 600000
        && str(request.resource.data, 'c', 20) && str(request.resource.data, 'v', 200) && str(request.resource.data, 'k', 10);
      allow get, list, delete: if true;
    }
    // Conexión directa celular ↔ TV (enviar juegos y mando de juego en Samsung/LG): solo se intercambian los datos para conectarse.
    match /rtc/{code}/s/{id} {
      allow create: if code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['t', 'sid', 'sdp', 'k', 'at'])
        && request.resource.data.t in ['offer', 'answer']
        && request.resource.data.at is number
        && request.resource.data.at > request.time.toMillis() - 600000
        && request.resource.data.at < request.time.toMillis() + 600000
        && str(request.resource.data, 'sid', 40) && str(request.resource.data, 'sdp', 30000) && str(request.resource.data, 'k', 10);
      allow get, list, delete: if true;
    }
  }
}
